# ==========================================================
# CONFIGURATION SUPABASE & IA - NYEGA WEB APPLICATION
# ==========================================================
# 1. Variables frontend Supabase (URL et clé publique anon) :
# Renseignées dans nyega-web/js/config.js pour la production
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Secrets côté serveur pour l'Edge Function de Catégorisation IA :
# Définissez ces secrets dans Supabase CLI via :
# supabase secrets set GEMINI_API_KEY="AIzaSy..."
# supabase secrets set GEMINI_MODEL="gemini-3.1-flash-lite"
# Ne committez JAMAIS de clé réelle dans ce fichier !
GEMINI_API_KEY=votre_cle_gemini_api_ici
GEMINI_MODEL=gemini-3.1-flash-lite
