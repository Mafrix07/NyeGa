# ==========================================================
# NYEGA - FICHIER D'IGNORANCE GIT (.gitignore)
# Sécurisation stricte avant mise en production
# ==========================================================

# 1. Variables d'environnement & Secrets (CRITIQUE)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Supabase secrets & local environment
supabase/.env
supabase/.env.*
supabase/.env.local
!supabase/.env.example
supabase/functions/*/.env
supabase/functions/*/.env.*
!supabase/functions/*/.env.example
.temp/
supabase/.temp/

# 2. Dépendances Node & Caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.npm

# 3. Fichiers système & IDE
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# 4. Logs & rapports d'erreurs
logs/
*.log
npm-audit.json
audit-report.*

# 5. Dossiers de builds & exports temporaires
dist/
build/
.cache/
tmp/
scratch/
*.csv
prompt*.txt
PT3.txt
REPONSE_PT3.txt
responsive.txt